Breaks the check of fuzz/fuzz_codec.c:335 (the fader LSB is shifted by 3, not 4).
Caught by the seed input "fader-full" of fuzz_codec.

diff --git a/src/diginet_codec.c b/src/diginet_codec.c
index 89a2aed..f09337c 100644
--- a/src/diginet_codec.c
+++ b/src/diginet_codec.c
@@ -103,7 +103,7 @@ int diginet_fader_encode(const struct diginet_personality *p, unsigned strip, un
 	out->bytes[1] = (uint8_t)strip;
 	out->bytes[2] = (uint8_t)(value >> 3);
 	out->bytes[3] = (uint8_t)(0x20 + strip);
-	out->bytes[4] = (uint8_t)((value & 7) << 4);
+	out->bytes[4] = (uint8_t)((value & 7) << 3);
 	out->len = 5;
 	out->display = 0;
 	out->key = DIGINET_KEY(DIGINET_KEY_FADER, strip);
