Breaks the check of fuzz/fuzz_decode.c:68 (the first data byte of a channel message is not checked for bit 7).
Caught by the seed input "status-for-data" of fuzz_decode.

diff --git a/src/diginet_msg.c b/src/diginet_msg.c
index 3932421..a4ec8d5 100644
--- a/src/diginet_msg.c
+++ b/src/diginet_msg.c
@@ -86,7 +86,7 @@ int diginet_msg_next(struct diginet_cursor *c, struct diginet_msg *m)
 		return DIGINET_E_TRUNCATED;
 	}
 	for (size_t i = 0; i < n; i++) {
-		if (b[data_at + i] & 0x80) {
+		if (b[data_at + i] & 0x80 && i) {
 			/* A status byte where a data byte is due: the message is cut short. */
 			c->pos = data_at + i;
 			c->status = 0;
