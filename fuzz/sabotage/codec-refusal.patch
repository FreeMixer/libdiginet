Breaks the check of fuzz/fuzz_codec.c:290 (only an empty 0x70 message is refused).
Caught by the seed input "sysex-system" of fuzz_codec.

diff --git a/src/diginet_codec.c b/src/diginet_codec.c
index 89a2aed..730c5f0 100644
--- a/src/diginet_codec.c
+++ b/src/diginet_codec.c
@@ -68,7 +68,7 @@ int diginet_sysex_encode(uint8_t device, uint8_t fn, const uint8_t *payload, siz
 {
 	if (!out || (len && !payload) || device > 0x7f)
 		return DIGINET_E_ARG;
-	if (fn == DIGINET_FN_SYSTEM)
+	if (fn == DIGINET_FN_SYSTEM && !len)
 		return DIGINET_E_REFUSED;
 	if (fn > 0x7f)
 		return DIGINET_E_RANGE;
