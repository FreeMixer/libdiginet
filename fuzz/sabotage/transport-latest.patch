Caught by the seed input "coalesce" of fuzz_transport.

diff --git a/transport/src/diginet_session.c b/transport/src/diginet_session.c
index 575b7e0..5fc385b 100644
--- a/transport/src/diginet_session.c
+++ b/transport/src/diginet_session.c
@@ -347,7 +347,7 @@ int diginet_session_submit(struct diginet_session *s, const struct diginet_cmd *
 	if (coalescable(c->key)) {
 		for (unsigned i = 0; i < s->queued; i++) {
 			if (s->queue[i].key == c->key) {
-				s->queue[i] = *c;   /* latest wins, in place */
+				s->queue[i].key = c->key;   /* latest wins, in place */
 				s->stats.coalesced++;
 				return DIGINET_OK;
 			}
